<mujoco model="sumo_scene">
  <compiler angle="radian"/>

  <option timestep="0.001" impratio="10" tolerance="1e-10" iterations="50"/>

  <default>
    <default class="ground">
      <geom condim="4" friction="0.9 0.005 0.001"/>
    </default>
    <default class="wheel">
      <geom type="cylinder" condim="4" friction="1.2 0.01 0.01" rgba="0 0 0 1"/>
    </default>
    <default class="robot_body">
      <geom condim="4" friction="0.5 0.005 0.001" solref="0.004" solimp="0.95 0.99"/>
    </default>
  </default>

  <asset>
    <mesh name="rampa_mesh" content_type="model/stl" file="assets/rampa.stl"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1"/>
    <body name="arena" pos="0 0 0.03">
      <geom name="dohyo_surface" class="ground" size="0.77 0.025" type="cylinder" rgba="0.15 0.15 0.15 1"/>
    </body>
    <body name="robot_A" pos="0 0.55 0.12">
      <joint name="robot_A_root" type="free"/>
      <geom name="robot_A_body" class="robot_body" size="0.1 0.1 0.05" type="box" rgba="0.667 0 0 1"/>
      <geom name="robot_A_rampa" class="robot_body" type="mesh" rgba="0.4 0.4 0.4 1" mesh="rampa_mesh"/>
      <body name="robot_A_wheel_left" pos="0.115 0.1 -0.01">
        <joint name="robot_A_left_wheel_joint" pos="0 0 0" axis="1 0 0" damping="0.01"/>
        <geom class="wheel" size="0.05 0.015" quat="0.707107 0 0.707107 0"/>
      </body>
      <body name="robot_A_wheel_right" pos="-0.115 0.09 -0.01">
        <joint name="robot_A_right_wheel_joint" pos="0 0 0" axis="1 0 0" damping="0.01"/>
        <geom class="wheel" size="0.05 0.015" quat="0.707107 0 0.707107 0"/>
      </body>
      <body name="robot_A_caster" pos="0 -0.1 -0.05">
        <joint name="robot_A_caster_joint" pos="0 0 0" type="ball" damping="0.001"/>
        <geom size="0.01" friction="0.01 0.001 0.001" rgba="0.667 0 0 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="robot_A_left" joint="robot_A_left_wheel_joint" biastype="affine" biasprm="0 0 -1"/>
    <general name="robot_A_right" joint="robot_A_right_wheel_joint" biastype="affine" biasprm="0 0 -1"/>
  </actuator>
</mujoco>
