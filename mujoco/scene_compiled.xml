<mujoco model="sumo_scene">
  <compiler angle="radian"/>

  <option timestep="0.001" impratio="10" tolerance="1e-10" iterations="50"/>

  <default>
    <default class="_main">
      <default class="_ground">
        <geom condim="4" friction="0.9 0.005 0.001"/>
      </default>
    </default>
    <default class="A_main">
      <default class="A_wheel">
        <geom type="cylinder" condim="4" friction="1.2 0.01 0.01" rgba="0 0 0 1"/>
      </default>
      <default class="A_robot_body">
        <geom condim="4" friction="0.5 0.005 0.001" solref="0.004" solimp="0.95 0.99"/>
      </default>
    </default>
  </default>

  <asset>
    <texture type="2d" colorspace="linear" name="_dohyo_tex" file="../assets/dohyo.PNG"/>
    <material name="_dohyo_mat" texture="_dohyo_tex"/>
    <mesh name="A_rampa_mesh" content_type="model/stl" file="../assets/rampa.stl"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1"/>
    <body pos="0 0 0.5">
      <joint type="free"/>
      <geom size="0.1" mass="10" rgba="0.8 0.8 0.8 1"/>
    </body>
    <body name="_arena" pos="0 0 0.03">
      <geom name="_dohyo_surface" class="_ground" size="0.77 0.025" type="cylinder" material="_dohyo_mat"/>
    </body>
    <body name="A_robot" pos="0 0.55 0.12">
      <joint name="A_robot_root" type="free"/>
      <geom name="A_robot_body" class="A_robot_body" size="0.1 0.1 0.05" type="box" rgba="0.667 0 0 1"/>
      <geom name="A_robot_rampa" class="A_robot_body" type="mesh" rgba="0.4 0.4 0.4 1" mesh="A_rampa_mesh"/>
      <body name="A_robot_wheel_left" pos="0.115 0.1 -0.01">
        <joint name="A_robot_left_wheel_joint" pos="0 0 0" axis="1 0 0" damping="0.01"/>
        <geom class="A_wheel" size="0.05 0.015" quat="0.707107 0 0.707107 0"/>
      </body>
      <body name="A_robot_wheel_right" pos="-0.115 0.09 -0.01">
        <joint name="A_robot_right_wheel_joint" pos="0 0 0" axis="1 0 0" damping="0.01"/>
        <geom class="A_wheel" size="0.05 0.015" quat="0.707107 0 0.707107 0"/>
      </body>
      <body name="A_robot_caster" pos="0 -0.1 -0.05">
        <joint name="A_robot_caster_joint" pos="0 0 0" type="ball" damping="0.001"/>
        <geom size="0.01" friction="0.01 0.001 0.001" rgba="0.667 0 0 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="A_robot_left" joint="A_robot_left_wheel_joint" biastype="affine" gainprm="0.5" biasprm="0 0 -0.5"/>
    <general name="A_robot_right" joint="A_robot_right_wheel_joint" biastype="affine" gainprm="0.5" biasprm="0 0 -0.5"/>
  </actuator>
</mujoco>
