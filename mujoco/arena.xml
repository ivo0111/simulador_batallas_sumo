<mujoco model="sumo_arena">

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <default>
        <!-- ruedas -->
        <default class="wheel">
            <geom friction="1.2 0.01 0.01" condim="4"/>
        </default>

        <!-- cuerpo del robot -->
        <default class="robot_body">
            <geom friction="0.5 0.005 0.001"
            condim="4"
            solref="0.004 1"
            solimp="0.95 0.99 0.001"/>
        </default>

        <!-- suelo -->
        <default class="ground">
            <geom friction="0.9 0.005 0.001" condim="4"/>
        </default>
    </default>

    <worldbody>
        <!-- Luz -->
        <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1"/>
        <body name="arena" pos="0 0 0.03">
            <geom name="dohyo_surface"
            type="cylinder"
            size="0.77 0.025"
            class="ground"
            rgba="0.15 0.15 0.15 1"/>
        </body>
    </worldbody>
</mujoco>