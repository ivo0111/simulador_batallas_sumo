<mujoco model="sumo_scene">

    <option timestep="0.001"
        gravity="0 0 -9.81"
        impratio="10"
        iterations="50"
        tolerance="1e-10" />

    <!-- robot.xml se referencia como asset primero -->
    <asset>
        <model name="robot_model" file="./components/sumobot.xml" />
        <model name="arena_model" file="./components/arena.xml" />
    </asset>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1"/>
        <!-- Arena -->
        <attach model="arena_model" body="arena" prefix="" />

        <!-- Robot A -->
        <frame pos="0 0.6 0.11" euler="0 0 90">
            <attach model="robot_model" body="robot" prefix="A_"/>
        </frame>

        <!-- Robot B -->
        <frame pos="0 -0.6 0.11" euler="0 0 -90">
            <attach model="robot_model" body="robot" prefix="B_"/>
        </frame>

    </worldbody>

</mujoco>